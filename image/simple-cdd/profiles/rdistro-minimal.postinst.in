#!/bin/sh
set -e

mkdir -p /etc/apt/sources.list.d

cat >/etc/apt/sources.list.d/rdistro.sources <<'APT_EOF'
Types: deb
URIs: @RDISTRO_REPO_URL@
Suites: @RDISTRO_REPO_SUITE@
Components: main
Architectures: arm64
Signed-By: /usr/share/keyrings/rdistro-archive-keyring.asc
APT_EOF

cat >/etc/rdistro-image <<'EOF2'
PROFILE=minimal
RELEASE=0.1
ARCH=arm64
EOF2

exit 0
