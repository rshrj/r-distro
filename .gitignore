# Build and controller state
/work/
/out/
/logs/

# Generated APT repositories
/repo/
/repo-pass1/
/repo-pass2/

# Signing material - never commit private keys
/keys/
*.gpg
*.asc
*.key

# Generated analysis output
/analysis/
/manifests/pass2/
/manifests/selfhost-boundary-arm64.txt

# Ad-hoc working manifests
/manifests/*-retry.txt

# Generated tree listing
/tree.txt

# Backups
*.bak

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# macOS
.DS_Store

# Editors
.vscode/
.idea/

# Temporary
*.tmp
*.swp
*~

# Debian native package build output (dpkg-buildpackage / debhelper)
packages/*/debian/*/
!packages/*/debian/source/
!packages/*/debian/patches/
packages/*/debian/files
packages/*/debian/*.substvars
packages/*/debian/*.debhelper.log
packages/*/debian/debhelper-build-stamp

# Installer image build output (simple-cdd / debian-cd)
/image/images/
/image/tmp/
/image/out/
*.iso

# Compiled from scripts/buildactivity.swift
/scripts/buildactivity

# The archive public key belongs in the keyring package source
!packages/rdistro-archive-keyring/keys/rdistro-archive-keyring.asc
